  entries:
  - stringID: HH01_Q1_Dodge
    speaker: "\uC7A5\uC560\uBB3C\uC744 \uD53C\uD558\uC790!"
    dialogue: "\u25B6 \uC88C\uC6B0\uB85C \uC6C0\uC9C1\uC774\uAE30\n\u25B6 \uBD80\uB52A\uD788\uC9C0
      \uC54A\uAE30"
  - stringID: HH01_Q2_Drift
    speaker: "\uB4DC\uB9AC\uD504\uD2B8\uB97C \uD558\uC790!"
    dialogue: "\u25B6 \uD0C0\uC774\uBC0D \uB9DE\uAC8C \uD0A4 \uB204\uB974\uAE30"
  - stringID: HH01_Q3_Knot
    speaker: "\uB9E4\uB4ED\uC744 \uC791\uB3D9\uC2DC\uD0A4\uC790!"
    dialogue: "\u25B6 \uAC74\uC804\uC9C0 \uCC3E\uAE30\n\u25B6 \uC7A5\uCE58\uC5D0
      \uB07C\uC6B0\uAE30"
  - stringID: HH01_Q4_Hold
    speaker: "\uB9E4\uB4ED\uC744 \uD0C0\uACE0\\n\uAC74\uB108\uAC00\uC790!"
    dialogue: "\u25B6 \uC810\uD504\uD558\uC5EC \uB9E4\uB4ED\uC744 \uBD99\uC7A1\uAE30"
  - stringID: HH01_Q5_Climb
    speaker: "\uC704\uB85C \uC62C\uB77C\uAC00\uC790!"
    dialogue: "\u25B6 \uACC4\uAD6C\uC5D0 \uC624\uB974\uAE30\n\u25B6 \uC810\uD504\uB97C
      \uC5F0\uD0C0\uD558\uAE30"
  - stringID: HH01_Q6_Throw
    speaker: "\uC801\uC744\\n\uD798\uAECF \uB0A0\uB824\uBC84\uB9AC\uC790!"
    dialogue: "\u25B6 \uC5FC\uB825\uC73C\uB85C \uB0A0\uB824 \uBCF4\uB0B4\uAE30\n\u25B6
      \uC5FC\uB825\uC740 \uC88C\uD074\uB9AD(LMB)"
  - stringID: HH01_Q7_Hold
    speaker: "\uC870\uBA85\uC744 \uC7A1\uACE0\\n\uAC74\uB108\uAC00\uC790!"
    dialogue: "\u25B6 \uAC00\uAE4C\uC774 \uC624\uB294 \uD0C0\uC774\uBC0D \uBCF4\uAE30\n\u25B6
      \uD0C0\uC774\uBC0D \uB9DE\uCD94\uC5B4 \uC810\uD504\uD558\uAE30"
  - stringID: HH01_Q8_Speaker
    speaker: "\uC2A4\uD53C\uCEE4\uB97C \uC774\uC6A9\uD558\uC790!"
    dialogue: "\u25B6 \uC804\uC6D0 \uBC84\uD2BC \uB204\uB974\uAE30\n\u25B6 \uBC84\uD2BC\uC744
      \uC88C\uD074\uB9AD(LMB)"
  - stringID: HH01_Q9_Chase
    speaker: "\uC0E4\uBE14\uCE74\uB97C\\n\uCAD3\uC544\uAC00\uC790!"
    dialogue: "\u25B6 \uC0E4\uBE14\uCE74\uAC00 \uD0C4 \uB9E4\uB4ED \uCC3E\uAE30\n\u25B6
      \uB9E4\uB4ED\uC744 \uD0C0\uACE0 \uB118\uC5B4\uAC00\uAE30"

  entries:
  - stringID: HH2
    speaker: "\uC0E4\uBE14\uCE74\uB97C \uCD94\uACA9\uD558\uC790!"
    dialogue: "\u25B6 \uBC27\uC904\uACFC \uD654\uC0B4\uB85C \uC0E4\uBE14\uCE74 \uCAD3\uAE30"
  - stringID: HH3_1
    speaker: "\uAE30\uACC4\uB97C \uC791\uB3D9\uC2DC\uD0A4\uC790!"
    dialogue: "\u25B6 \uAC74\uC804\uC9C0 \uCC3E\uAE30\n\u25B6 \uC7A5\uCE58\uC5D0
      \uB07C\uC6B0\uAE30"
  - stringID: HH3_2
    speaker: "\uAE30\uB465\uC744 \uB530\uB77C\\n\uC62C\uB77C\uAC00\uC790!"
    dialogue: "\u25B6 \uD1B1\uB2C8\uBC14\uD034 \uAE30\uB465\uC744 \uD0C0\uACE0 \uC62C\uB77C\uAC00\uAE30"
  - stringID: HH3_3
    speaker: "\uC7A5\uC2B9\uC744 \uC774\uC6A9\uD574\\n\uAC74\uB108\uAC00\uC790!"
    dialogue: "\u25B6 \uD0C0\uC774\uBC0D\uC5D0 \uB9DE\uCDB0 \uC5FC\uB825 \uC0AC\uC6A9\uD558\uAE30"
  - stringID: HH4
    speaker: "\uD50C\uB7EC\uADF8\uB97C \uBAA8\uB450\\n\uC5F0\uACB0\uD558\uC790!"
    dialogue: "\u25B6 \uC228\uACA8\uC9C4 \uD50C\uB7EC\uADF8 4\uAC1C \uCC3E\uAE30\n\u25B6
      \uD50C\uB7EC\uADF8\uB97C \uC81C\uC790\uB9AC\uC5D0 \uAF42\uAE30"
  - stringID: OW2
    speaker: "\uB192\uC740 \uACF3\uC73C\uB85C\\n\uC62C\uB77C\uAC00\uC790!"
    dialogue: "\u25B6 \uC67C\uCABD \uB354\uBBF8\uB97C \uBC1F\uACE0 \uC62C\uB77C\uAC00\uAE30"
  - stringID: TB_1
    speaker: "\uD504\uB9B0\uD130\uC5D0\uC11C\\n\uBE60\uC838\uB098\uC624\uC790!"
    dialogue: "\u25B6 F\uD0A4\uB97C \uC5F0\uD0C0\uD574 \uD0C8\uCD9C\uD558\uAE30"
  - stringID: TB_2
    speaker: "\uBC84\uD2BC\uC744 \uC21C\uC11C\uB300\uB85C\\n\uB204\uB974\uC790!"
    dialogue: "\u25B6 J, K, L\uD0A4\uB85C \uBC84\uD2BC \uC870\uC791\uD558\uAE30\n\u25B6
      \uC21C\uC11C\uC5D0 \uB9DE\uAC8C \uBC84\uD2BC \uB204\uB974\uAE30"
  - stringID: TB_3
    speaker: "\uBE44\uBC00\uBC88\uD638\uB97C\\n\uC785\uB825\uD558\uC790!"
    dialogue: "\u25B6 \uC88C\uD074\uB9AD\uC73C\uB85C \uD0A4\uBCF4\uB4DC \uC0C1\uD638\uC791\uC6A9\n\u25B6
      \uD328\uC2A4\uC6CC\uB4DC \uC785\uB825\uD558\uAE30"
  - stringID: TB_4
    speaker: "\uC228\uC744 \uACF3\uC744\\n\uCC3E\uC544\uBCF4\uC790!"
    dialogue: "\u25B6 \uC0AC\uB78C\uC744 \uD53C\uD574 \uC228\uAE30"
  - stringID: TB_5
    speaker: "\uD578\uB4DC\uD3F0\uC744 \uBC00\uC5B4\\n\uBC84\uD2BC\uC744 \uB204\uB974\uC790!"
    dialogue: "\u25B6 \uD578\uB4DC\uD3F0\uC744 \uC55E\uC73C\uB85C \uBC00\uAE30\n\u25B6
      \uD2F0\uCF13 \uCD9C\uB825\uAE30 \uC804\uC6D0 \uCF1C\uAE30"
  - stringID: TB_6
    speaker: "\uD2F0\uCF13\uC744 \uAE38\uAC8C\\n\uCD9C\uB825\uD558\uC790!"
    dialogue: "\u25B6 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD2F0\uCF13 \uCD9C\uB825\uD558\uAE30"
  - stringID: TB_7
    speaker: "\uB9C8\uC774\uD06C\uC5D0 \uB4E4\uC5B4\uAC08\\n\uC18C\uB9AC\uB97C \uCC3E\uC790!"
    dialogue: "\u25B6 \uBB34\uC804\uAE30 \uC18C\uB9AC\uC5D0 \uADC0 \uAE30\uC6B8\uC774\uAE30"
  - stringID: TB_8
    speaker: "\uB9C8\uC774\uD06C\uB97C \uCF1C\uBCF4\uC790!"
    dialogue: "\u25B6 \uB9C8\uC774\uD06C \uBC84\uD2BC \uB20C\uB7EC \uC791\uB3D9\uD558\uAE30"
  - stringID: TB_9
    speaker: "\uC2A4\uD53C\uCEE4\uB97C \uC774\uC6A9\uD574\\n\uC62C\uB77C\uAC00\uC790!"
    dialogue: "\u25B6 \uC2A4\uD53C\uCEE4 \uC9C4\uB3D9\uC744 \uD0C0\uACE0 \uC62C\uB77C\uAC00\uAE30"
  - stringID: TB_10
    speaker: "\uD39C\uC744 \uC544\uB798\uB85C\\n\uB0B4\uB9AC\uC790!"
    dialogue: "\u25B6 \uC11C\uBA85\uD560 \uD39C \uAD74\uB9AC\uAE30"
  - stringID: TB_11
    speaker: "\uBC14\uB78C\uC744 \uBA48\uCD9C\\n\uBC29\uBC95\uC744 \uCC3E\uC790!"
    dialogue: "\u25B6 C\uD0A4\uB85C \uBC14\uB78C \uBC84\uD2F0\uAE30\n\u25B6 \uC120\uD48D\uAE30
      \uC804\uC6D0 \uB044\uAE30"
  - stringID: TB_12
    speaker: "\uC601\uC218\uC99D\uC744 \uCD9C\uB825\uD574\uBCF4\uC790!\\n(1/4)"
    dialogue: "\u25B6 \uC5FC\uB825\uC73C\uB85C \uD39C \uB4E4\uAE30\n\u25B6 \uD39C\uC73C\uB85C
      \uC11C\uBA85\uD558\uAE30"
  - stringID: TB_13
    speaker: "\uC601\uC218\uC99D\uC744 \uCD9C\uB825\uD574\uBCF4\uC790!\\n(2/4)"
    dialogue: "\u25B6 \uD78C\uD2B8 \uD655\uC778\uD558\uAE30\n\u25B6 \uC21C\uC11C\uC5D0
      \uB9DE\uAC8C \uBC84\uD2BC \uB204\uB974\uAE30"
  - stringID: TB_14
    speaker: "\uC601\uC218\uC99D\uC744 \uCD9C\uB825\uD574\uBCF4\uC790!\\n(3/4)"
    dialogue: "\u25B6 \uCE74\uB4DC \uB300\uC2E0 \uC790\uC2E0\uC73C\uB85C \uAE01\uC5B4\uBCF4\uAE30"
  - stringID: TB_15
    speaker: "\uC601\uC218\uC99D\uC744 \uCD9C\uB825\uD574\uBCF4\uC790!\\n(4/4)"
    dialogue: "\u25B6 \uD78C\uD2B8 \uD655\uC778\uD558\uAE30\n\u25B6 \uC21C\uC11C\uC5D0
      \uB9DE\uAC8C \uBC84\uD2BC \uB204\uB974\uAE30"
  - stringID: TB_16
    speaker: "\uD658\uD48D\uAD6C\uB85C\\n\uC774\uB3D9\uD558\uC790!"
    dialogue: "\u25B6 \uC601\uC218\uC99D\uC744 \uD0C0\uAE30\n\u25B6 \uD658\uD48D\uAD6C\uAE4C\uC9C0
      \uC62C\uB77C\uAC00\uAE30"
  - stringID: Bumper1-2
    speaker: "\uC55E\uC73C\uB85C \uB098\uC544\uAC00\uC790!"
    dialogue: "\u25B6 \uC774\uB3D9\uD558\uBA70 \uC0E4\uBE14\uCE74 \uBD84\uC2E0 \uCC3E\uAE30"
  - stringID: Bumper1-3_1
    speaker: "\uCDA9\uB3CC\uC744 \uD53C\uD558\uC790!"
    dialogue: "\u25B6 \uD0C0\uC774\uBC0D\uC5D0 \uB9DE\uCDB0 QTE \uC131\uACF5\uD558\uAE30"
  - stringID: Bumper1-3_2
    speaker: "\uB05D\uAE4C\uC9C0 \uBC84\uD2F0\uC790!"
    dialogue: "\u25B6 Q\uD0A4\uB97C \uC5F0\uD0C0\uD574 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uAE30"
  - stringID: Bumper1-3_3
    speaker: "\uB2E4\uC2DC \uD55C\uBC88\\n\uBC84\uD2F0\uC790!"
    dialogue: "\u25B6 Q\uD0A4\uB97C \uC5F0\uD0C0\uD574 \uB05D\uAE4C\uC9C0 \uBC84\uD2F0\uAE30"
  - stringID: Bumper1-3_4
    speaker: "\uB2E4\uC74C \uBC94\uD37C\uCE74\uB85C\\n\uC774\uB3D9\uD558\uC790!"
    dialogue: "\u25B6 QTE \uD0C0\uC774\uBC0D\uC5D0 \uB9DE\uCDB0 \uC810\uD504\uD558\uAE30"
  - stringID: Bumper1-4_1
    speaker: "\uBD84\uC2E0\uC744 \uCAD3\uC790!\\n(1/2)"
    dialogue: "\u25B6 \uC606 \uBC94\uD37C\uCE74\uB85C \uAC08 \uAE38 \uCC3E\uAE30"
  - stringID: Bumper1-4_2
    speaker: "\uBD84\uC2E0\uC744 \uCAD3\uC790!\\n(2/2)"
    dialogue: "\u25B6 \uC548\uD14C\uB098\uAE4C\uC9C0 \uB3C4\uB2EC\uD558\uAE30"
  - stringID: Ceiling_1
    speaker: "\uC0E4\uBE14\uCE74\uC640 \uC7E8\uBC84\uB9AC\uB97C\\n\uCD94\uACA9\uD558\uC790!"
    dialogue: "\u25B6 \uC0E4\uBE14\uCE74 \uBD84\uC2E0 \uCC98\uCE58\uD558\uAE30\n\u25B6
      \uBC14\uB78C\uC744 \uD0C0\uACE0 \uC62C\uB77C\uAC00\uAE30"
  - stringID: Ceiling_2
    speaker: "\uAD6C\uB974\uC790! \uCCD0\uB0B4\uC790!"
    dialogue: "\u25B6 \uBC30\uAD00 \uC18D\uC744 \uAD74\uB7EC\uAC00\uAE30\n\u25B6
      \uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD558\uAE30"
  - stringID: Ceiling_3
    speaker: "\uD658\uD48D\uAD6C\uB97C\\n\uC791\uB3D9\uD558\uC790!"
    dialogue: "\u25B6 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD658\uD48D\uAD6C \uCF1C\uAE30\n\u25B6

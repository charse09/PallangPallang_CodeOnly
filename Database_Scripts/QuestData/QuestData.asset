  - stringID: Ceiling_4
    speaker: "\uCD94\uACA9\uC744 \uC774\uC5B4\uAC00\uC790!"
    dialogue: "\u25B6 \uC0E4\uBE14\uCE74\uC640 \uC7E8\uBC84\uB9AC \uB530\uB77C\uAC00\uAE30\n\u25B6
      \uBC30\uAD00 \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uAE30"
  - stringID: Ceiling_5
    speaker: "\uAE30\uACC4 \uD314\uC744 \uD53C\uD574\\n\uB3C4\uB9DD\uAC00\uC790!"
    dialogue: "\u25B6 \uC55E\uC73C\uB85C \uB2EC\uB824\uAC00\uAE30\n\u25B6 \uAE30\uACC4

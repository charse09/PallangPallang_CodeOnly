  - stringID: Ceiling_6
    speaker: "\uC5B4\uB514\uB85C \uAC14\uC744\uC9C0\\n\uCC3E\uC544\uBCF4\uC790!"
    dialogue: "\u25B6 \uC0E4\uBE14\uCE74\uC640 \uC7E8\uBC84\uB9AC \uCC3E\uAE30"
  - stringID: Boss_1
    speaker: "\uC7E8\uBC84\uB9AC\uB97C \uB9C9\uC544\uB0B4\uC790!\\n(1/3)"
    dialogue: "\u25B6 \uCDA9\uC804 \uBC29\uD574\uD558\uAE30\n\u25B6 \uCF58\uC13C\uD2B8

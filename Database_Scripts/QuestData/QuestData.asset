  - stringID: Boss_2
    speaker: "\uC7E8\uBC84\uB9AC\uB97C \uB9C9\uC544\uB0B4\uC790!\\n(2/3)"
    dialogue: "\u25B6 \uB124\uAC70\uD2F0\uBE0C\uD2B8\uB860\uC758 \uBC29\uC804\uAE4C\uC9C0
